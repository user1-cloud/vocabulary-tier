# ============================================================================
# VocTier .gitignore
# ============================================================================

# ---- 构建产物 ---------------------------------------------------------------
/target/
**/target/
apps/desktop/dist/
# tauri-build 自动生成的 ACL schema 缓存
apps/desktop/src-tauri/gen/

# ---- 依赖 -------------------------------------------------------------------
node_modules/

# ---- 生成的数据与临时目录 ---------------------------------------------------
# ⚠ 这两项一定要忽略：
#   /data/  是 vocfreq scan 的产物（这里 0.5 GB），其中 meta.json 记录了
#           **语料库的绝对路径**；
#   /.tmp/  是本地构建临时目录、WebView2 缓存（几百 MB）、应用日志、Playwright
#           与截图草稿。
/data/
/.tmp/

# 从语料导出的自定义词典属于派生数据，别入库
/tools/userdict_*.txt
/tools/oov_candidates*.tsv

# ---- 本地 / 个人配置 --------------------------------------------------------
# 应用设置实际存在 %APPDATA%\com.voctier.desktop\settings.json（在仓库之外，
# 不会被提交）。下面兜住将来可能出现的仓库内本地覆盖配置。
*.local
*.local.*
.env
.env.*
!.env.example
voctier.local.toml
settings.local.json

# ---- 编辑器 / 系统 ----------------------------------------------------------
.vscode/
.idea/
*.swp
*~
Thumbs.db
desktop.ini
